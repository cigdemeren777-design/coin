FROM node:24-bookworm-slim
WORKDIR /app
COPY core.js live-paper.js paper-worker.js ./
RUN mkdir /paper-data && chown node:node /paper-data
USER node
ENV PAPER_DATA_DIR=/paper-data
ENV PAPER_PORT=8766
HEALTHCHECK --interval=30s --timeout=6s --start-period=25s CMD node -e "fetch('http://127.0.0.1:8766/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "paper-worker.js"]
